# =============================================================================
# swanctl.conf — Generated by render_configs.py
# Scenario : {{ scenario.id }}
# Name     : {{ scenario.name }}
# Generated: {{ generated_at }}
#
# WARNING: This file is auto-generated. Do not edit manually.
#          Edit testbed/scenarios/scenarios.yaml and re-run render_configs.py.
#
# This is the MODERN strongSwan configuration format (swanctl / VICI).
# Requires strongSwan >= 5.7 with the vici plugin enabled.
# Used for all IKEv2 scenarios. IKEv1 scenarios fall back to ipsec.conf.
# =============================================================================

# ---------------------------------------------------------------------------
# Connections block
# ---------------------------------------------------------------------------
connections {

    {{ scenario.id }} {

        # --- IKE version ---
        version = {{ scenario.ike_version }}

        # --- Peer addresses ---
        local_addrs  = {{ scenario.left_ip }}
        remote_addrs = {{ scenario.right_ip }}

        # --- IKE proposals (Phase 1) ---
        # strongSwan notation: encryption-prf-dh  (integrity = prf for IKEv2)
        {% if scenario.integrity %}
        proposals = {{ scenario.encryption }}-{{ scenario.integrity }}-{{ scenario.prf }}-{{ scenario.dh_group }}
        {% else %}
        # AEAD cipher — no separate integrity algorithm
        proposals = {{ scenario.encryption }}-{{ scenario.prf }}-{{ scenario.dh_group }}
        {% endif %}

        # --- SA lifetimes ---
        rekey_time   = 3600    # IKE SA rekey interval (seconds)
        reauth_time  = 0       # 0 = no reauthentication (rekey only)
        over_time    = 300     # grace period after rekey_time

        # --- DPD (Dead Peer Detection) ---
        dpd_delay    = 30      # seconds between DPD probes
        dpd_timeout  = 120     # seconds before declaring peer dead

        # --- Local authentication ---
        local {
            id = {{ scenario.left_ip }}
            {% if scenario.auth_method == 'psk' %}
            auth = psk
            {% elif scenario.auth_method == 'cert' %}
            auth = pubkey
            certs = {{ scenario.id }}_left.crt.pem
            {% endif %}
        }

        # --- Remote authentication ---
        remote {
            id = {{ scenario.right_ip }}
            {% if scenario.auth_method == 'psk' %}
            auth = psk
            {% elif scenario.auth_method == 'cert' %}
            auth = pubkey
            certs = {{ scenario.id }}_right.crt.pem
            {% endif %}
        }

        # --- Child SA (ESP) ---
        children {

            {{ scenario.id }}_child {

                # --- IPsec mode ---
                mode = {{ scenario.mode }}

                {% if scenario.mode == 'tunnel' and scenario.left_subnet %}
                # --- Protected traffic selectors (tunnel mode) ---
                local_ts  = {{ scenario.left_subnet }}
                remote_ts = {{ scenario.right_subnet }}
                {% else %}
                # --- Transport mode: protect host-to-host traffic ---
                local_ts  = {{ scenario.left_ip }}/32
                remote_ts = {{ scenario.right_ip }}/32
                {% endif %}

                # --- ESP proposals (Phase 2) ---
                {% if scenario.integrity %}
                # CBC mode: encryption + integrity
                esp_proposals = {{ scenario.encryption }}-{{ scenario.integrity }}{% if scenario.pfs %}-{{ scenario.dh_group }}{% endif %}

                {% else %}
                # AEAD mode: encryption only (GCM provides integrity)
                esp_proposals = {{ scenario.encryption }}{% if scenario.pfs %}-{{ scenario.dh_group }}{% endif %}

                {% endif %}

                # --- Perfect Forward Secrecy ---
                {% if scenario.pfs %}
                # PFS enabled: Child SA rekeying performs DH exchange
                # dh_group is included in esp_proposals above
                {% else %}
                # PFS disabled: no DH in Child SA rekeying
                # (dh_group omitted from esp_proposals)
                {% endif %}

                # --- Child SA lifetimes ---
                rekey_time   = 1800    # ESP SA rekey interval (seconds)
                life_time    = 2100    # hard lifetime (rekey_time + 300)
                rand_time    = 300     # randomisation window

                # --- Replay protection ---
                replay_window = 32

                # --- Startup action ---
                start_action = start
                close_action = restart
                dpd_action   = restart

                # --- Inactivity timeout (0 = disabled) ---
                inactivity = 0
            }
        }
    }
}

# ---------------------------------------------------------------------------
# Secrets block
# ---------------------------------------------------------------------------
secrets {

    {% if scenario.auth_method == 'psk' %}
    # Pre-Shared Key
    ike-{{ scenario.id }} {
        id-left  = {{ scenario.left_ip }}
        id-right = {{ scenario.right_ip }}
        secret   = "{{ psk_secret }}"
    }
    {% elif scenario.auth_method == 'cert' %}
    # Private key for left peer certificate
    private-{{ scenario.id }}-left {
        file = {{ scenario.id }}_left.key.pem
    }
    {% endif %}
}

