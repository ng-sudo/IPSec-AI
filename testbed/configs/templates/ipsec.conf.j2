# =============================================================================
# ipsec.conf — Generated by render_configs.py
# Scenario : {{ scenario.id }}
# Name     : {{ scenario.name }}
# Generated: {{ generated_at }}
#
# WARNING: This file is auto-generated. Do not edit manually.
#          Edit testbed/scenarios/scenarios.yaml and re-run render_configs.py.
# =============================================================================
#
# This is the LEGACY strongSwan configuration format (ipsec.conf).
# It is used for:
#   - IKEv1 scenarios (ike_version: 1)
#   - Fallback on older strongSwan installations (< 5.7)
#
# For IKEv2 scenarios on strongSwan >= 5.7, prefer swanctl.conf.
# =============================================================================

config setup
    # Increase debug level for testbed captures (0=silent, 4=verbose)
    charondebug="ike 2, knl 2, cfg 2, net 1, esp 1, dmn 1"
    # Disable uniqueids to allow multiple SAs from same IP (namespace testing)
    uniqueids=no

# ---------------------------------------------------------------------------
# Connection: {{ scenario.id }}
# ---------------------------------------------------------------------------
conn {{ scenario.id }}

    # --- IKE version ---
    keyexchange=ikev{{ scenario.ike_version }}

    # --- Authentication ---
    authby={{ scenario.auth_method }}

    # --- Peer addresses ---
    left={{ scenario.left_ip }}
    right={{ scenario.right_ip }}

    # --- IPsec mode ---
    type={{ scenario.mode }}

    {% if scenario.mode == 'tunnel' and scenario.left_subnet %}
    # --- Protected subnets (tunnel mode) ---
    leftsubnet={{ scenario.left_subnet }}
    rightsubnet={{ scenario.right_subnet }}
    {% endif %}

    # --- IKE proposal (Phase 1) ---
    # Format: encryption-integrity-dhgroup
    {% if scenario.ike_version == 2 %}
    ike={{ scenario.encryption }}-{{ scenario.integrity if scenario.integrity else 'aes256gcm16' }}-{{ scenario.prf }}-{{ scenario.dh_group }}!
    {% else %}
    # IKEv1: encryption-hash-dhgroup
    ike={{ scenario.encryption }}-{{ scenario.integrity if scenario.integrity else 'sha256' }}-{{ scenario.dh_group }}!
    {% endif %}

    # --- ESP proposal (Phase 2 / Child SA) ---
    {% if scenario.integrity %}
    # CBC mode: encryption + integrity
    esp={{ scenario.encryption }}-{{ scenario.integrity }}{% if scenario.pfs %}-{{ scenario.dh_group }}{% endif %}!
    {% else %}
    # AEAD mode: encryption only (integrity implicit in GCM tag)
    esp={{ scenario.encryption }}{% if scenario.pfs %}-{{ scenario.dh_group }}{% endif %}!
    {% endif %}

    # --- Perfect Forward Secrecy ---
    {% if scenario.pfs %}
    # PFS enabled: Child SA rekeying uses DH group {{ scenario.dh_group }}
    pfs=yes
    {% else %}
    # PFS disabled: Child SA rekeying does NOT perform new DH exchange
    pfs=no
    {% endif %}

    # --- Startup & DPD ---
    auto=start
    dpdaction=restart
    dpddelay=30s
    dpdtimeout=120s

    # --- SA lifetimes ---
    ikelifetime=3600s
    lifetime=1800s
    margintime=180s
    keyingtries=%forever

    # --- Replay protection ---
    replay_window=32

    # --- Left peer role (initiator in testbed) ---
    leftid={{ scenario.left_ip }}
    rightid={{ scenario.right_ip }}
