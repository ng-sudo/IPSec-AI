# =============================================================================
# strongswan.conf — Generated by render_configs.py
# Scenario : {{ scenario.id }}
# Generated: {{ generated_at }}
#
# WARNING: This file is auto-generated. Do not edit manually.
# =============================================================================
#
# Global strongSwan daemon configuration.
# This file configures the charon IKE daemon and its plugins.
# =============================================================================

charon {

    # -------------------------------------------------------------------------
    # Logging configuration
    # -------------------------------------------------------------------------
    # Log to a file for post-capture analysis.
    # Levels: -1=silent, 0=audit, 1=control, 2=diag, 3=raw, 4=private
    filelog {
        "/var/log/charon_{{ scenario.id }}.log" {
            # Log all subsystems at diagnostic level for testbed captures
            default = 2
            # Per-subsystem overrides
            ike    = 2    # IKE protocol messages
            knl    = 2    # kernel (xfrm) interactions
            cfg    = 2    # configuration loading
            net    = 1    # network I/O
            esp    = 1    # ESP processing
            dmn    = 1    # daemon lifecycle
            mgr    = 1    # SA manager
            # Flush log after each line (important for real-time monitoring)
            flush_line = yes
            # Include timestamps
            time_format = %Y-%m-%dT%H:%M:%S
            # Include log level in each line
            append = no
        }
    }

    # Also log to syslog (useful in Docker / systemd environments)
    syslog {
        daemon {
            default = 1
        }
    }

    # -------------------------------------------------------------------------
    # Plugin configuration
    # -------------------------------------------------------------------------
    plugins {

        # Kernel interface: use xfrm (Netlink) for Linux
        kernel-netlink {
            # Enable routing table manipulation
            install_routes = yes
            # Flush xfrm state on startup to avoid stale SAs
            fwmark = 0x0
        }

        # Random number generator
        random {
            # Use /dev/urandom for testbed (faster; /dev/random may block)
            random = /dev/urandom
            urandom = /dev/urandom
        }

        # Resolve plugin: DNS resolution for peer IDs
        resolve {
            # Disable in namespace environment (no DNS)
            load = no
        }

        # VICI plugin: management interface for swanctl
        vici {
            # Socket path — must match swanctl's expected path
            socket = /var/run/charon.vici
        }

        # Updown plugin: execute scripts on SA up/down events
        updown {
            # Script called when Child SA is established or torn down
            # Used by deploy_scenario.sh to detect SA establishment
            updown = /etc/strongswan.d/updown_{{ scenario.id }}.sh
        }

        # Stroke plugin: legacy ipsec.conf interface (needed for IKEv1)
        {% if scenario.ike_version == 1 %}
        stroke {
            load = yes
        }
        {% else %}
        stroke {
            load = no
        }
        {% endif %}

        # Cipher suites
        openssl {
            load = yes
        }

        # AES plugin (software fallback if no hardware AES-NI)
        aes {
            load = yes
        }

        # SHA plugin
        sha2 {
            load = yes
        }

        # Diffie-Hellman
        curve25519 {
            load = yes
        }

        # GCM support (AEAD)
        {% if 'gcm' in scenario.encryption %}
        gcm {
            load = yes
        }
        {% endif %}
    }

    # -------------------------------------------------------------------------
    # Miscellaneous settings
    # -------------------------------------------------------------------------

    # Number of worker threads (2 is sufficient for testbed)
    threads = 4

    # Ignore routing table changes from other processes
    ignore_routing_tables = 0

    # Install virtual IPs (not needed in namespace testbed)
    install_virtual_ip = no

    # Retransmission settings (aggressive for testbed — fast failure detection)
    retransmit_tries    = 5
    retransmit_timeout  = 2.0
    retransmit_base     = 1.5

    # Maximum IKE SA half-open time (seconds)
    half_open_timeout = 30

    # Close IKE SA when last Child SA is deleted
    close_ike_on_child_failure = no
}

# ---------------------------------------------------------------------------
# libstrongswan global settings
# ---------------------------------------------------------------------------
libstrongswan {

    # Crypto test on startup (set to no for faster startup in testbed)
    crypto_test {
        on_add    = no
        on_create = no
        required  = no
        rng_true  = no
    }

    # Plugin loading order
    plugins {
        # Ensure openssl is loaded before built-in plugins
        openssl {
            load = yes
        }
    }
}
