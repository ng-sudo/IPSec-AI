# =============================================================================
# ipsec.secrets — Generated by render_configs.py
# Scenario : {{ scenario.id }}
# Generated: {{ generated_at }}
#
# WARNING: This file contains secrets. It is .gitignore'd under
#          testbed/configs/generated/. Never commit this file.
# =============================================================================

{% if scenario.auth_method == 'psk' %}
# ---------------------------------------------------------------------------
# Pre-Shared Key (PSK) authentication
# Format: <left_id> <right_id> : PSK "<secret>"
# ---------------------------------------------------------------------------
{{ scenario.left_ip }} {{ scenario.right_ip }} : PSK "{{ psk_secret }}"

# Also match by wildcard for namespace testing (both peers on same host)
%any %any : PSK "{{ psk_secret }}"

{% elif scenario.auth_method == 'cert' %}
# ---------------------------------------------------------------------------
# RSA Certificate authentication
# Format: : RSA <private_key_file>
# ---------------------------------------------------------------------------
# Left peer private key (relative to /etc/ipsec.d/private/ or absolute path)
: RSA {{ scenario.id }}_left.key.pem

# Right peer private key
: RSA {{ scenario.id }}_right.key.pem

{% endif %}
